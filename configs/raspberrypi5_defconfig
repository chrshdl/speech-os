BR2_aarch64=y
BR2_cortex_a76=y
BR2_ARM_FPU_VFPV4=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# python-scipy builds LAPACK, which is Fortran.
BR2_TOOLCHAIN_BUILDROOT_FORTRAN=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="speech"
BR2_TARGET_GENERIC_ISSUE="Speech OS"
# The kiosk's clock shows local time: Hamburg's. The rootfs is read only, so
# /etc/localtime is set here rather than with timedatectl.
BR2_TARGET_LOCALTIME="Europe/Berlin"
BR2_INIT_SYSTEMD=y
# No local console to set up (kiosk on the panel, kernel log on tty3): no
# systemd-vconsole-setup, its udev rule or kbd's keymaps and fonts.
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DEFAULT_PATH="/bin:/sbin:/usr/bin:/usr/sbin"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/users.table"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/post-image.sh"
# The board directory, for the post-build and post-image scripts the boards share.
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi5"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
# 4 KB pages, not bcm2712_defconfig's 16 KB (see the fragment).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi5/linux-4k-page-size.fragment $(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/linux-module-compress-gzip.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_PLUGINS=y
BR2_PACKAGE_LIBSAMPLERATE=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_FBV=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi5/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi5/cmdline.txt"
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_WPEWEBKIT=y
# Web Audio (GStreamer to ALSA): the client chimes when listening starts and ends.
BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA=y
# And plays songs, which Web Audio's decodeAudioData decodes with giostreamsrc,
# decodebin and deinterleave. WPEWEBKIT_MULTIMEDIA selects neither the first nor
# the last, and without either the web process crashes decoding a song.
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_GIO=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_INTERLEAVE=y
# speech-backend decodes web radio with the ffmpeg program (HTTPS through
# OpenSSL), which the FFmpeg that gst1-libav selects builds by default.
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFMPEG=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_COG=y
# BR2_PACKAGE_COG_PLATFORM_FDO is not set
BR2_PACKAGE_COG_PLATFORM_DRM=y
# The MIME database (mime.cache only): without it GIO knows no file's type,
# and WebKit renders no file:// page, such as the kiosk's first page.
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2025.04"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_arm64"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/uboot-fragment.config"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
# Must match the kernel's CONFIG_MODULE_COMPRESS_* (gzip, see board/raspberrypi/linux-module-compress-gzip.fragment).
# Host depmod reads the built .ko files to generate modules.dep/modules.alias;
# without the matching decompressor it fails SILENTLY and emits EMPTY ones, and
# udev then autoloads nothing. The post-build script asserts they are populated.
BR2_PACKAGE_HOST_KMOD_GZ=y
BR2_PACKAGE_HOST_MTOOLS=y
# fw_printenv/fw_setenv (with /etc/fw_env.config): RAUC's U-Boot backend runs
# them to mark the booted slot good; without them every boot burns an attempt.
BR2_PACKAGE_LIBUBOOTENV=y
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SOURCE="$(BR2_EXTERNAL_SPEECH_OS_PATH)/board/raspberrypi/uboot-env.txt"
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SIZE="0x4000"
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_REDUNDANT=y
BR2_PACKAGE_PYTHON_SPEECH=y
