config BR2_PACKAGE_PYTHON_PIPER_TTS
	bool "python-piper-tts"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_PACKAGE_PYTHON_ONNXRUNTIME_ARCH_SUPPORTS
	depends on BR2_INSTALL_LIBSTDCPP # python-onnxruntime
	depends on BR2_PACKAGE_PYTHON_NUMPY_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9 # python-numpy
	depends on BR2_HOST_GCC_AT_LEAST_9 # host-python-numpy
	select BR2_PACKAGE_PYTHON_NUMPY # runtime
	select BR2_PACKAGE_PYTHON_ONNXRUNTIME # runtime
	select BR2_PACKAGE_PYTHON3_UNICODEDATA # runtime
	help
	  Piper, a fast neural text to speech system that runs on a
	  Raspberry Pi, with its Python API. Its voices are separate
	  .onnx files.

	  Installed from the official manylinux wheel for aarch64, which
	  has espeak-ng, for the phonemes, linked into its extension.

	  https://github.com/OHF-Voice/piper1-gpl

comment "python-piper-tts needs an aarch64 glibc toolchain w/ C++"
	depends on BR2_PACKAGE_PYTHON3
	depends on !BR2_PACKAGE_PYTHON_ONNXRUNTIME_ARCH_SUPPORTS || \
		!BR2_INSTALL_LIBSTDCPP
