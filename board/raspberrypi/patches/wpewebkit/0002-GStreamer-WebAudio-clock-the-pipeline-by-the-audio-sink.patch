+    // The audio device paces the rendering: the source renders silence too,
+    // and blocks while the sink's ring buffer is full. Its clock is the
+    // pipeline's, so nothing is slaved to the system clock. Picked on going
+    // to PLAYING, the pipeline's clock would be the system clock: the source
+    // is live, so the sink has no ring buffer yet to provide its clock with.
+    // The sink then corrects the device's drift from it by jumping tens of
+    // milliseconds at a time, and with the source synchronized to the
+    // system clock by a clocksync, every segment played on in part.
+    if (auto* clock = audioSinkClock(audioSink.get()))
+        gst_pipeline_use_clock(GST_PIPELINE_CAST(m_pipeline.get()), clock);
