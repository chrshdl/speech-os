+// How long after rendering the device plays the audio: how far the source has
+// pushed ahead of the position the sink plays at, by the device's clock.
+MediaTime AudioDestinationGStreamer::outputLatency() const
+{
+    gint64 position;
+    if (!m_src || !gst_element_query_position(m_pipeline.get(), GST_FORMAT_TIME, &position) || position < 0)
+        return MediaTime::zeroTime();
+    GstClockTime pushed = webkitWebAudioSourceGetPushedTime(WEBKIT_WEB_AUDIO_SRC(m_src.get()));
+    if (pushed <= static_cast<GstClockTime>(position))
+        return MediaTime::zeroTime();
+    return fromGstClockTime(pushed - position);
+}
