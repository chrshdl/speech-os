+// Fills the sink and the appsrc's queue with silence before the first quantum
+// renders after starting. They would otherwise take the first quanta as fast as
+// they render, until full, and the context's time would jump ahead by that much,
+// past the start of what was scheduled right after the context resumed, such as
+// a tone at its currentTime, which would then play cut.
+static void webKitWebAudioSrcPrefill(WebKitWebAudioSrc* src)
+{
+    auto* priv = src->priv;
+    guint64 frames = gst_util_uint64_scale_round(webAudioSinkBufferTime + webAudioSinkLatencyTime, priv->sampleRate, GST_SECOND)
+        + appSrcQueuedQuanta * priv->framesToPull;
+    GRefPtr<GstBuffer> buffer = adoptGRef(gst_buffer_new_allocate(nullptr, frames * priv->bus->numberOfChannels() * sizeof(float), nullptr));
+    gst_buffer_memset(buffer.get(), 0, 0, gst_buffer_get_size(buffer.get()));
+    gst_buffer_add_audio_meta(buffer.get(), &priv->info, frames, nullptr);
+    GST_BUFFER_TIMESTAMP(buffer.get()) = gst_util_uint64_scale(priv->numberOfSamples, GST_SECOND, priv->sampleRate);
+    GST_BUFFER_DURATION(buffer.get()) = gst_util_uint64_scale(frames, GST_SECOND, priv->sampleRate);
+    priv->numberOfSamples += frames;
+    GST_DEBUG_OBJECT(src, "Prefilling the sink with %" G_GUINT64_FORMAT " frames of silence", frames);
+    // Failures, such as flushing, show on pushing the rendered quantum next.
+    gst_app_src_push_buffer(GST_APP_SRC(priv->source.get()), buffer.leakRef());
+}
