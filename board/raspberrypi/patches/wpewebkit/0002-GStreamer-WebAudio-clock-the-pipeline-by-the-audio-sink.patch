+// The clock of the audio device the sink plays on, from the sink or, for
+// a bin like autoaudiosink once it is READY, the sink inside it.
+static GstClock* audioSinkClock(GstElement* sink)
+{
+    if (GST_IS_AUDIO_BASE_SINK(sink))
+        return GST_AUDIO_BASE_SINK(sink)->provided_clock;
+    if (!GST_IS_BIN(sink))
+        return nullptr;
+
+    GstClock* clock = nullptr;
+    GstIterator* iterator = gst_bin_iterate_recurse(GST_BIN_CAST(sink));
+    GValue item = G_VALUE_INIT;
+    while (!clock && gst_iterator_next(iterator, &item) == GST_ITERATOR_OK) {
+        auto* element = GST_ELEMENT_CAST(g_value_get_object(&item));
+        if (GST_IS_AUDIO_BASE_SINK(element))
+            clock = GST_AUDIO_BASE_SINK(element)->provided_clock;
+        g_value_reset(&item);
+    }
+    g_value_unset(&item);
+    gst_iterator_free(iterator);
+    return clock;
+}
